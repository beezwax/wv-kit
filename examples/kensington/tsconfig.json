{
  "compilerOptions": {
    "module":            "esnext",
    "moduleResolution":  "bundler",
    "target":            "es2022",
    "lib":               ["es2022", "dom", "dom.iterable"],
    "allowJs":           true,
    "checkJs":           false,
    "strict":            true,
    "noEmit":            true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "isolatedModules":   true
  },
  "include": ["src/**/*", "fm/**/*"],
  "exclude": ["node_modules", "dist"]
}
