{
  "name": "wv-kit",
  "version": "0.1.0",
  "description": "Dev server and build tooling for FileMaker web viewer projects",
  "author": {
    "name": "Ryan Lee Simms",
    "url": "https://www.beezwax.net/beez/ryan-simms"
  },
  "type": "module",
  "bin": {
    "wv-kit": "./bin/wv-kit.js"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./eslint.config.js": "./eslint.config.js",
    "./lib/*": "./lib/*",
    "./vite.config.js": "./vite.config.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "files": [
    "AGENTS.md",
    "bin",
    "eslint.config.js",
    "lib",
    "vite.config.js"
  ],
  "dependencies": {
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "jsdom": "^28.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "vite": ">=8"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
